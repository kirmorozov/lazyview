# Non-secret lazyview settings (all variables: README.md "Configuration").
# Credentials come from the Secret `lazyview-db` (LAZYVIEW_HOST/_PORT/_USER/_PASSWORD/_DATABASE
# or LAZYVIEW_DSN).

# Must match the container port `http` (8080). An unspecified address listens on IPv4 and IPv6.
LAZYVIEW_HEALTH_ADDR=0.0.0.0:8080
LAZYVIEW_LOG_FORMAT=json
RUST_LOG=info

# Every replica must use the same instance id: it names the lock that makes one replica active
# and the others hot standbys, and the key of the saved binlog position.
LAZYVIEW_INSTANCE_ID=default
LAZYVIEW_START_MODE=resume
LAZYVIEW_BATCH_WINDOW_MS=200

# Probes (src/health.rs). /livez fails after this many seconds without engine progress.
LAZYVIEW_LIVENESS_STALL_SECS=120
# /readyz tolerates a disconnected binlog stream this long (reconnects do not flap readiness).
LAZYVIEW_READY_DISCONNECT_GRACE_SECS=30
# true: a view in error state makes /readyz fail. Default false: reported, alert on
# lazyview_views_error instead (a broken definition must not block rollouts and node drains).
LAZYVIEW_READY_REQUIRE_ALL=false
