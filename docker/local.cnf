# Local speed and memory settings for the integration-test servers on a developer host, mounted
# by docker-compose.local.yml (scripts/test-servers.sh compose up adds that file; CI never does).
# Commits stop waiting for an fsync of the binlog and of the redo log: a crash of the container
# (not of mysqld alone) can lose the last second of commits, which test data can afford. CI
# keeps the durable server defaults (sync_binlog=1, innodb_flush_log_at_trx_commit=1).
#
# Memory: hours of suites that create thousands of tables grow a server's memory (table caches,
# allocator arenas) until the container's limit kills it on a shared host. Smaller table caches
# keep the servers well inside their limits; docker-compose.local.yml also sets MALLOC_ARENA_MAX=2.
# MariaDB accepts table_open_cache_instances too.
[mysqld]
sync_binlog=0
innodb_flush_log_at_trx_commit=2
table_open_cache=400
table_open_cache_instances=1
table_definition_cache=400
